{
  "stateDatabase": "./state/bridge.sqlite3",
  "taskWorkspaces": {
    "enabled": true,
    "directory": "./state/task-workspaces"
  },
  "projects": [
    {
      "id": "main",
      "cwd": ".",
      "sandboxMode": "workspace-write",
      "writableRoots": [],
      "networkAccess": false
    }
  ],
  "defaultProjectId": "main",
  "telegram": {
    "allowedUserIds": ["123456789"],
    "allowedChatIds": ["123456789"],
    "rateLimit": {
      "perChatRefillPerSecond": 1,
      "perChatBurst": 3,
      "globalRefillPerSecond": 25,
      "globalBurst": 25,
      "maxAttempts": 3,
      "maxRetryAfterSeconds": 60,
      "jitterMaxMs": 150
    }
  },
  "attachments": {
    "directory": "./state/attachments",
    "maxBytes": 20971520,
    "allowedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/gif",
      "text/plain",
      "text/markdown",
      "text/csv",
      "application/json",
      "application/pdf",
      "application/xml",
      "text/xml"
    ]
  },
  "outboundMedia": {
    "enabled": true,
    "directory": "./state/outbound-media",
    "maxBytes": 20971520
  },
  "albums": {
    "flushMs": 2000
  },
  "voice": {
    "provider": "none",
    "model": "whisper-large-v3-turbo",
    "language": "ru",
    "apiRoot": "https://api.groq.com/openai/v1",
    "maxBytes": 20971520,
    "requestTimeoutMs": 60000
  },
  "codex": {
    "approvalPolicy": "on-request",
    "sandboxMode": "workspace-write",
    "allowedSandboxModes": ["read-only", "workspace-write"],
    "turnTimeoutMs": 0,
    "interactionTimeoutMs": 600000
  },
  "productDecisions": {
    "enabled": false,
    "repositoryPath": "/absolute/path/to/vpn-infra",
    "remote": "origin",
    "push": true
  },
  "productHome": {
    "enabled": false,
    "publicUrl": "https://example.com/product-home/"
  },
  "ux": {
    "enabled": true,
    "chatStatusMessages": false,
    "typingIndicator": true,
    "receivedReaction": true,
    "pinnedStatus": true,
    "typingRefreshMs": 4000,
    "quotaRefreshMs": 300000,
    "heartbeatAfterMs": 120000,
    "heartbeatIntervalMs": 300000,
    "pollIntervalMs": 30000
  },
  "health": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8787,
    "startupGraceMs": 60000,
    "staleAfterMs": 120000,
    "maxConsecutiveErrors": 3
  },
  "retention": {
    "enabled": true,
    "payloadMaxAgeDays": 30,
    "intervalMs": 21600000
  }
}
