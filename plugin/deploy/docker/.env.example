# Generated automatically by `./docker.sh setup`. This example exists for
# operators who deliberately invoke Compose without the wrapper.
COMPOSE_PROJECT_NAME=codex-tg-wire
CODEX_TG_WIRE_PROJECT_PATH=/srv/my-project
CODEX_TG_WIRE_CONFIG_DIR=/home/me/.config/codex-tg-wire/docker
CODEX_TG_WIRE_STATE_DIR=/home/me/.local/share/codex-tg-wire
CODEX_TG_WIRE_CODEX_HOME=/home/me/.local/share/codex-tg-wire/codex-home
CODEX_TG_WIRE_UID=1000
CODEX_TG_WIRE_GID=1000

CODEX_TG_WIRE_IMAGE=codex-tg-wire:1.0.0
CODEX_TG_WIRE_LOGIN_IMAGE=codex-tg-wire-login:1.0.0
CODEX_TG_WIRE_VERSION=1.0.0
BUN_VERSION=1.4.0
CODEX_CLI_VERSION=0.149.1
