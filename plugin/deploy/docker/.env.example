# Host path mounted at /workspace. Use an absolute path.
DASHI_PROJECT_PATH=/srv/my-project
DASHI_BRIDGE_CONFIG=./bridge.config.json
DASHI_BRIDGE_ENV_FILE=./bridge.env
DASHI_TELEGRAM_TOKEN_FILE=./telegram-token

# Release and runtime pins. Change only together with the compatibility matrix.
DASHI_BRIDGE_IMAGE=dashi-codex-bridge:1.0.0
BUN_VERSION=1.4.0
CODEX_CLI_VERSION=0.149.1
