{
  "stateDatabase": "/var/lib/dashi/bridge.sqlite3",
  "projects": [
    {
      "id": "main",
      "cwd": "/workspace",
      "sandboxMode": "workspace-write",
      "writableRoots": [],
      "networkAccess": false
    }
  ],
  "defaultProjectId": "main",
  "telegram": {
    "allowedUserIds": ["123456789"],
    "allowedChatIds": ["123456789"]
  },
  "attachments": {
    "directory": "/var/lib/dashi/attachments"
  },
  "outboundMedia": {
    "enabled": true,
    "directory": "/var/lib/dashi/outbound-media"
  },
  "codex": {
    "approvalPolicy": "on-request",
    "sandboxMode": "workspace-write",
    "allowedSandboxModes": ["read-only", "workspace-write"],
    "interactionTimeoutMs": 600000
  },
  "health": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8787,
    "startupGraceMs": 60000,
    "staleAfterMs": 120000,
    "maxConsecutiveErrors": 3
  },
  "retention": {
    "enabled": true,
    "payloadMaxAgeDays": 30,
    "intervalMs": 21600000
  }
}
