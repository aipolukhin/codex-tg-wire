[Unit]
Description=codex-tg-wire durable Telegram bridge for Codex
Documentation=file:/opt/dashi-codex-bridge/current/docs/codex-installation.md
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
NotifyAccess=all
User=dashi-codex
Group=dashi-codex
WorkingDirectory=/opt/dashi-codex-bridge/current
EnvironmentFile=-/etc/dashi-codex-bridge/bridge.env
LoadCredential=telegram-token:/etc/dashi-codex-bridge/telegram-token
Environment=HOME=/var/lib/dashi-codex-bridge
Environment=CODEX_HOME=/var/lib/dashi-codex-bridge/codex-home
Environment=DASHI_CODEX_BRIDGE_CONFIG=/etc/dashi-codex-bridge/bridge.config.json
# Run the service entry point directly so WATCHDOG_PID matches the notifying process.
ExecStart=/usr/bin/env bun /opt/dashi-codex-bridge/current/plugin/src/codex-telegram-service.ts
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=120s
WatchdogSec=180s

StateDirectory=dashi-codex-bridge
StateDirectoryMode=0700
ConfigurationDirectory=dashi-codex-bridge
ConfigurationDirectoryMode=0750
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
