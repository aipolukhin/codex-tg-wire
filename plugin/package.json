{
  "name": "dashi-channel",
  "version": "1.3.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0 <2"
  },
  "bin": "./src/server.ts",
  "scripts": {
    "start": "bun run src/server.ts",
    "start:codex": "bun run src/codex-telegram-service.ts",
    "test": "bun test",
    "test:codex": "bun test tests/codex",
    "typecheck": "tsc --noEmit",
    "init:codex": "bun run scripts/codex-bridge-init.ts",
    "doctor:codex": "bun run scripts/codex-bridge-doctor.ts",
    "backup:codex": "bun run scripts/codex-bridge-backup.ts",
    "restore:codex": "bun run scripts/codex-bridge-restore.ts",
    "licenses:codex": "bun run scripts/supply-chain.ts --check",
    "sbom:codex": "bun run scripts/supply-chain.ts --sbom ./dist/dashi-codex-bridge.cdx.json",
    "release:codex": "bun run scripts/build-release-artifacts.ts",
    "soak:codex": "bun run scripts/codex-bridge-soak.ts --duration-seconds 259200 --rate 20",
    "soak:codex:smoke": "bun run scripts/codex-bridge-soak.ts --duration-seconds 5 --rate 30",
    "codex:smoke": "bun run scripts/codex-app-server-smoke.ts",
    "codex:schema:check": "bun run scripts/check-codex-schema.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "grammy": "1.44.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
