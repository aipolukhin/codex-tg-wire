[Unit]
Description=Razvilka Product Home Telegram Mini App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=razvilka-product-home
Group=razvilka-product-home
Environment=PRODUCT_HOME_CONFIG=/etc/razvilka-product-home/config.json
ExecStart=/opt/razvilka-product-home/current/product-home-server
Restart=on-failure
RestartSec=3s
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
